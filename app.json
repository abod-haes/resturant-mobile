{
  "expo": {
    "name": "Restaurant Employee",
    "slug": "restaurant-employee",
    "scheme": "restaurantemployee",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/waiter.wav",
            "./assets/sounds/hookah.wav"
          ],
          "color": "#075E53"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.restaurantemployee"
    }
  }
}
