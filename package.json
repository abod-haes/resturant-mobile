{
  "name": "restaurant-employee",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:architecture": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:config": "expo config --type public",
    "api:generate": "openapi-typescript contracts/employee.openapi.json -o src/shared/api/generated/restaurant.d.ts",
    "api:check": "node scripts/api-contract.mjs check",
    "lint": "eslint app src tests --max-warnings=0"
  },
  "dependencies": {
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.14",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "heroui-native": "^1.0.8",
    "lucide-react-native": "0.544.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "~0.5.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.0",
    "uniwind": "^1.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0",
    "openapi-typescript": "7.10.1",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~10.0.0"
  }
}
